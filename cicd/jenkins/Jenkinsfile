pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/python -m pip install --upgrade pip
                    .venv/bin/python -m pip install -r requirements.txt
                '''
            }
        }

        stage('Install Trivy') {
            steps {
                sh '''
                    if ! command -v trivy >/dev/null 2>&1; then
                        wget -qO- https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin
                    fi
                '''
            }
        }

        stage('Build Scanner Image') {
            steps {
                sh 'docker build -t vuln-scanner:local .'
            }
        }

        stage('Run Vulnerability Scan') {
            steps {
                script {
                    def scanStatus = sh(
                        script: '.venv/bin/python -m scanner.scan python:3.8 --output-json scan_result.json',
                        returnStatus: true
                    )

                    echo "Scanner exit code: ${scanStatus}"
                }
            }
        }

        stage('Security Gate') {
            steps {
                script {
                    def gateStatus = sh(
                        script: '.venv/bin/python scanner/gate_check.py scan_result.json',
                        returnStatus: true
                    )

                    if (gateStatus != 0) {
                        error("Security gate failed with exit code ${gateStatus}")
                    }
                }
            }
        }

    post {
        failure {
            withCredentials([
                string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK_URL')
            ]) {
                sh '.venv/bin/python notifications/notifier.py scan_result.json --channel slack'
            }
        }

        always {
            archiveArtifacts artifacts: 'scan_result.json', allowEmptyArchive: true
            echo 'Jenkins pipeline completed.'
        }
    }
}
